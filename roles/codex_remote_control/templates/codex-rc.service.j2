# {{ ansible_managed }}
# Managed by role codex_remote_control
[Unit]
Description=Codex CLI Remote Control (experimental)

[Service]
Type=simple
WorkingDirectory={{ _codex_rc_home }}/{{ _codex_rc_entry.rel }}
Environment=HOME={{ _codex_rc_home }}
Environment=CODEX_HOME={{ _codex_rc_home }}/.codex
Environment=PATH={{ _codex_rc_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Foreground mode lets systemd own the process and its lifecycle.
ExecStart={{ _codex_rc_home }}/.local/bin/codex remote-control --no-daemon
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
