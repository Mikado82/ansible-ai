# {{ ansible_managed }}
# Managed by role codex_remote_control
[Unit]
Description=Codex CLI Remote Control (experimental)

[Service]
Type=simple
# Foreground mode lets systemd own the process and its lifecycle. Without a
# work_dir the home directory is the working directory.
WorkingDirectory={{ _codex_rc_home }}{% if _codex_rc_entry.rel %}/{{ _codex_rc_entry.rel }}{% endif %}
Environment=HOME={{ _codex_rc_home }}
Environment=CODEX_HOME={{ _codex_rc_home }}/.codex
Environment=PATH={{ _codex_rc_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Foreground mode lets systemd own the process and its lifecycle.
# --cd tells the agent to use the work_dir as its working root
# (verified against codex-cli 0.167.1; there is no --config-dir flag).
ExecStart={{ _codex_rc_home }}/.local/bin/codex{% if _codex_rc_entry.rel %} --cd {{ _codex_rc_home }}/{{ _codex_rc_entry.rel }}{% endif %} remote-control --no-daemon
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
